{
  // Checks the Soundpad layer, navigation and settings: the code that talks to another process and
  // reads its answers. The plugin runs as plain JavaScript on Studio's Node, with no build step, so
  // this never emits anything.
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "files": [
    "com.ulanzi.soundpadpro.ulanziPlugin/plugin/soundpad/xml.js",
    "com.ulanzi.soundpadpro.ulanziPlugin/plugin/soundpad/protocol.js",
    "com.ulanzi.soundpadpro.ulanziPlugin/plugin/soundpad/pipe-client.js",
    "com.ulanzi.soundpadpro.ulanziPlugin/plugin/soundpad/identity.js",
    "com.ulanzi.soundpadpro.ulanziPlugin/plugin/soundpad/library.js",
    "com.ulanzi.soundpadpro.ulanziPlugin/plugin/soundpad/service.js",
    "com.ulanzi.soundpadpro.ulanziPlugin/plugin/settings.js",
    "com.ulanzi.soundpadpro.ulanziPlugin/plugin/navigation.js",
    "com.ulanzi.soundpadpro.ulanziPlugin/plugin/global-store.js",
    "com.ulanzi.soundpadpro.ulanziPlugin/plugin/inspector-api.js"
  ]
}
