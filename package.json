{
  "name": "ulanzi-deck-soundpad-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Development tooling for the Soundpad Controller plugin for Ulanzi Studio.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.12.2"
  },
  "scripts": {
    "setup": "npm ci && npm ci --prefix com.ulanzi.soundpadpro.ulanziPlugin",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "test:live": "node --test test/live/soundpad.live.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "build:glyphs": "node scripts/build-glyphs.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "package": "node scripts/package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:sdk": "node scripts/check-sdk.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "measure": "node scripts/measure.mjs",
    "bump": "node scripts/bump-version.mjs",
    "audit": "npm audit && npm audit --prefix com.ulanzi.soundpadpro.ulanziPlugin"
  },
  "devDependencies": {
    "@fontsource/outfit": "5.3.0",
    "@types/node": "20.19.43",
    "opentype.js": "2.0.0",
    "typescript": "5.9.3",
    "ws": "8.22.1"
  }
}
